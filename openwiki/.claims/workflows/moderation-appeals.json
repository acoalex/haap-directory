    {
      "id": "claim_47a9734e990d4d0c950680c4e6e3929f",
      "statement": "POST /v1/agents/{fp}/appeal is agent-signed, not moderator-signed: moderation.appeal loads the agent row (AGENT_NOT_FOUND 404 if unknown), verifies the signature over the canonical subset {fingerprint, statement} against the agent's registered public key (failure raises SIGNATURE_MISMATCH 400), inserts an appeals row with id 'ap_' + hex and status 'open', and appends audit event appeal.submitted with actor 'agent:<fp>'; the code does not require the agent to be suspended to file an appeal.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/moderation.py#L110-L124",
          "version": "repo-lines-v1:sha256:dbaa74e2a9d22e257c31cd4b926a4f07fde6170eb233fcecc6c36cff876cd901:"
