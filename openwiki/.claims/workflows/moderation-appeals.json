    {
      "id": "claim_c0c685200665479384dba65f690794d9",
      "statement": "POST /v1/agents/{fp}/unsuspend restores a suspended entry through store.unsuspend_agent, which accepts only rows whose status is 'suspended' (unknown, listed, or expired rows return None surfaced as AGENT_NOT_FOUND 404); it sets status 'listed', clears suspension_json and suspended_at, resets is_history to 0, grants a fresh TTL of config.ttl_seconds measured from now, and appends audit event moderator.unsuspend with actor 'moderator:<fp>' and result ok in the same transaction; the route responds 200 {status: listed}.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/moderation.py#L96-L108",
          "version": "repo-lines-v1:sha256:a2d4724019b2cce37b590b826e86a106fa2367d47bf939401d9c62dc4541411d:"
