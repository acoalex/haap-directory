    {
      "id": "claim_52087f2bde1f4c1e9fb3fc3d35e553f3",
      "statement": "Suspension is persisted on the agent row as status 'suspended' plus suspension_json {rule, evidence_reports, at (RFC 3339)} and suspended_at; store.suspend_agent is the single suspension writer shared by moderator takedown, moderator direct suspend and the reputation auto-suspend automaton (each passing its own rule, evidence list, actor and audit event), and it appends exactly one hash-chain audit entry with result 'suspended' in the same SQLite transaction as the status UPDATE.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/store.py#L887-L911",
          "version": "repo-lines-v1:sha256:f0c7885ec473babfa3dd44960c9e18ecbd623a6fa714ab110bf77341528138cb:"
