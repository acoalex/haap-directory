  "claims": [
    {
      "id": "claim_909dd5d4a79643709b0c459b5b29df27",
      "statement": "Moderators are operator-held Ed25519 keys configured out of band: DirectoryConfig.moderator_keys holds standard-base64 public keys (set in ~/.haap/dird.json), and at ModerationService construction each key's fingerprint (HF- + first 16 hex chars of sha256 of the raw key) is derived via fingerprint_of_public_key and stored in a fingerprint -> public_key_b64 map; only fingerprints in that construction-time map can authorize actions, and malformed config entries are skipped.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/config.py#L67-L68",
          "version": "repo-lines-v1:sha256:b1ee9a0a381e23ebe7c21758c28d592373924a7c141dbe286770f6e2f281dc62:"
        },
        {
          "resource": "repo://src/haap_directory/identity.py#L14-L22",
          "version": "repo-lines-v1:sha256:fb7ccb29176800aec4effceb39860fe22024ab2ddbcc9469e78c9f59d95ff1a5:"
        },
        {
          "resource": "repo://src/haap_directory/moderation.py#L23-L42",
          "version": "repo-lines-v1:sha256:2339fecc6448f9e451b762e59c098abca65b862e626bd24be5de663fc44aac28:"
        }
      ]
    },
    {
      "id": "claim_f7e1fb2013684f4f90c788eb4fa24b4f",
      "statement": "Every moderator action first runs ModerationService._authorize_moderator over an exact payload subset: an unknown moderator_fingerprint raises MODERATOR_UNKNOWN (403) before any signature check, and a signature failing Ed25519 verification over the canonical JSON of the subset raises TAKEDOWN_UNAUTHORIZED (403); subsets are takedown {moderator_fingerprint, report_id, reason}, suspend {moderator_fingerprint, fingerprint, reason}, unsuspend {moderator_fingerprint, fingerprint}, verified against the configured key with the shared canonical serializer (sort_keys, compact separators, ensure_ascii=false), so extra body fields are ignored.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/canonical.py#L22-L26",
          "version": "repo-lines-v1:sha256:f83501419bb070a1e64cba8f9dc21fbb544cfd806668b4d3b27323868b252332:"
        },
        {
