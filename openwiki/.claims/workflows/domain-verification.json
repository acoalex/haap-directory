    {
      "id": "claim_710f4a644503440c91c2cc835abd94f3",
      "statement": "Pending domain challenges are rows of the shared challenges table with kind='domain' and the token stored in the nonce column; the request appends audit domain.verify_requested in the same transaction, and confirm_domain_verification atomically marks the challenge used, inserts a domain_verifications row (id, fingerprint, domain, method, verified_at/epoch, expires_at/epoch, endpoint_match, challenge_id) and appends audit domain.verified — all in one write transaction.",
      "evidence": [
