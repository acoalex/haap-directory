    {
      "id": "claim_c704664c99ab485f86ed6c984e1d6e8b",
      "statement": "A confirmed verification expires purely by read-time filtering: active_domain_verifications selects only rows with expires_epoch >= now, so once the 90 days pass every projection (profile trust block, search, /v1/verify-domain/status, heartbeats) downgrades domain_verified to false immediately with no stored transition; expired challenge and verification rows are not deleted by the pruner.",
