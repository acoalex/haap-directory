          "version": "repo-lines-v1:sha256:d0182f5cf984854bb2454ac3935d4292fa054c5687f89e21c4099d9c7ab9e690:"
        },
        {
          "resource": "repo://tests/test_audit_chain.py#L32-L38",
          "version": "repo-lines-v1:sha256:a55e3f1ced3c79076501a7d5f448e27733fa1a09f3fe7a8e648a670149df1b8e:"
        }
