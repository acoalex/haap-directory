          "version": "repo-lines-v1:sha256:5f74e84c2e4290dbf11d9f041197d5924d1885893d842e0e05839665e23c38b3:"
        }
      ]
    },
    {
      "id": "claim_e2b390a8f6f54352a77a5cd1d6ca7e91",
      "statement": "All chain hashes and directory signatures are computed over the vendored canonical JSON serializer in canonical.py (sort_keys, separators ',', ':', ensure_ascii=False, UTF-8) that is byte-identical to the serializer the haap client package uses, so the directory, consumers and mirrors always hash and sign the same bytes.",
