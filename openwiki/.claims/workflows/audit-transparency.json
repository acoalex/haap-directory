  "claims": [
    {
      "id": "claim_6ad97cdefa2d4c46912891bb41b84d27",
      "statement": "The L5 audit chain is the directory's public record of every state change: each state-changing Store write appends exactly one chain entry inside the same SQLite write transaction as the mutation it records, so the chain row count equals committed mutating ops by construction and a failed (rolled-back) mutation leaves no entry.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/store.py#L211-L261",
          "version": "repo-lines-v1:sha256:9360b4af1ced11374c64697387a94aa01dba98a70064e3d2218fd126a2df5bfa:"
        },
        {
          "resource": "repo://src/haap_directory/store.py#L7-L11",
          "version": "repo-lines-v1:sha256:4f4b8177313b4cd9378cb7507b57ee2475e3b4367fb7f5dd9bc5f73ba50ad592:"
        },
        {
          "resource": "repo://tests/test_audit_chain.py#L16-L21",
          "version": "repo-lines-v1:sha256:6e8b2466f1b957ed2a20bdc1898f3cf12fb861c7ccc776a930fcdecf900fdb83:"
        }
      ]
    },
    {
      "id": "claim_476f1a9564554f14b0c2bef08def56e6",
      "statement": "Chain construction is normative SPEC §3.6.1 and pure: entry[n] = {seq, ts, event, fingerprint, actor, result, detail_hash, prev_hash}; entry_hash[n] = sha256 of the canonical JSON of entry[n]; the genesis entry is seq 0 with prev_hash '0'*64 and event 'chain.genesis', appended by Store at first boot of an empty database inside a write transaction.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit.py#L26-L64",
          "version": "repo-lines-v1:sha256:60476e4fb51d4ac398116f769cb3720b30d025a1c8178544b07d5a6baa6c2b87:"
        },
        {
          "resource": "repo://src/haap_directory/store.py#L263-L274",
          "version": "repo-lines-v1:sha256:ed747038a0b38b328e7927a0a921cbdedbfe7e5e729a418c15ff422f1cd880de:"
        }
      ]
    },
    {
      "id": "claim_707df9acaaf74111822702c0f2cd947d",
      "statement": "Audit entries never carry sensitive detail bodies: detail_hash is the sha256 hex of the canonical JSON of a small detail object ({} when None), which is the only trace of event details that enters the chain, so manifest internals, nonces and report evidence stay out of the public log.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit.py#L34-L36",
          "version": "repo-lines-v1:sha256:86cf56d91cb3d6428580644d066345c9008ab465bbbd3ae65027f8a9ef35dbd1:"
        },
        {
          "resource": "repo://tests/test_audit_chain.py#L50-L56",
          "version": "repo-lines-v1:sha256:d1b4c9787215930dbea44ed2f0ba18461ec7610fd408ded6e08053eefee9e498:"
        }
      ]
    },
    {
      "id": "claim_bbab0ded60874c508cb936f1f06916df",
      "statement": "audit.verify_chain(entries) re-computes every entry_hash from an entry's eight canonical fields, compares it with the stored entry_hash, and checks that each row's prev_hash equals the previous row's entry_hash; any modification, deletion or reordering fails verification — flipping a single event field is detected.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit.py#L67-L91",
          "version": "repo-lines-v1:sha256:44577e95fb492de2aac181a9990d273b73621cfd47ca1d91a4ba57504a6ae4c6:"
        },
        {
          "resource": "repo://tests/test_audit_chain.py#L41-L47",
          "version": "repo-lines-v1:sha256:4ae354ea3dfb88784e53ee618a162bec46ae6ba7d8b4950e8f4528e9238b08a0:"
        }
      ]
    },
    {
      "id": "claim_1c54bdaeb5b2499b8495e205d2fbbdc2",
      "statement": "Checkpoints are signed on the configured cadence: DirectoryHTTPServer.start() launches a daemon checkpoint thread that calls audit.maybe_checkpoint() every config.checkpoint_interval_s (default 3600 s = hourly), and maybe_checkpoint only signs a new checkpoint when the elapsed time since the latest persisted checkpoint reaches the interval unless force=True; exceptions in the loop are swallowed so the server never crashes.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit_service.py#L60-L70",
          "version": "repo-lines-v1:sha256:3f3607f1049eb5dd3d13e24dae5530ee55a6a7bdbdb89dbabb785bff49c65c7c:"
        },
        {
          "resource": "repo://src/haap_directory/config.py#L64-L65",
          "version": "repo-lines-v1:sha256:65a3c951c2ffd598f4383c61e4133940eef382a8083d207754b26dcfa6a00bea:"
        },
        {
          "resource": "repo://src/haap_directory/http_api.py#L94-L105",
          "version": "repo-lines-v1:sha256:5207cc4b510c1010ec4f8ae1af3d6be2054254939ddb868f0a579c1480126f7a:"
        }
      ]
    },
    {
      "id": "claim_c388b43fc59f4bdba8ceadc8b43ad10e",
      "statement": "A final checkpoint is signed on shutdown: DirectoryHTTPServer.stop() sets the stop event, shuts the HTTP socket, then calls audit.create_checkpoint() best-effort before store.close(), so a clean shutdown always persists a signed snapshot of the final head (verified by a test that reopens the DB after stop).",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L124-L135",
          "version": "repo-lines-v1:sha256:1ac7bbc6a288e9f024a06ef94ed6683f861a17b467fa490448c1b32b96368e32:"
        },
        {
          "resource": "repo://tests/test_checkpoints.py#L80-L88",
          "version": "repo-lines-v1:sha256:4f4eb8f278d83ce56abe540e1a806c31cf40eca67a95f46b75f666013703188d:"
        }
      ]
    },
    {
      "id": "claim_a0ad1b01b5fc4ea7bbd3db05177c593d",
      "statement": "create_checkpoint signs the canonical JSON of {seq, entry_hash, ts} of the current head with the directory Ed25519 key and persists it to the checkpoints table via INSERT OR REPLACE keyed by the head seq (at most one checkpoint per head seq); GET /v1/audit/head always serves the head as that signed payload plus a checkpoint_signature field.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit_service.py#L45-L58",
          "version": "repo-lines-v1:sha256:0e762768191a3af78d974ec384cea576f907e833468538be9bb01b8cabbfa044:"
        },
