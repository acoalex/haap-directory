          "version": "repo-lines-v1:sha256:89637768c1492d462b62923a25b3043dcfca743cdf6549294bb8a79cf3fc372d:"
        }
      ]
    },
    {
      "id": "claim_7bf99b10b6324b5f81acc6dc46d7b814",
      "statement": "GET /v1/agents/{fp}/audit (a v1-only route) returns a redacted per-agent projection whose rows carry only seq, ts, event, fingerprint, actor, result and detail_hash — never a detail body and no prev_hash/entry_hash linkage columns — limited to the first 200 matching rows in ascending seq order, so the projection cannot be re-chained in isolation and must be cross-referenced against /v1/audit/log by seq.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L290-L294",
          "version": "repo-lines-v1:sha256:4c844197d4dc259ed2de34a784de4cfcd73fd00932204f6e4e9b93c2ee589f83:"
