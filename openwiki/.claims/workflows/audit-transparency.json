          "version": "repo-lines-v1:sha256:9d6d66c4e0a6b4924e835e36980d6fe59b93a226d320106381b7181eb1e054e7:"
        },
        {
          "resource": "repo://src/haap_directory/store.py#L956-L962",
          "version": "repo-lines-v1:sha256:3225d689192b79d416426f34c46f8a5000a98746d5f23f1f3a17dcc1ef23b673:"
        }
      ]
    },
    {
      "id": "claim_ff372212ffe54404a0180cb536061af7",
      "statement": "GET /v1/audit/log?after=<seq>&limit=<n> serves contiguous ascending full chain rows (each including stored prev_hash and entry_hash): after defaults to -1 (so after=-1 starts at genesis seq 0), limit defaults to 100 and is clamped server-side to 1–1000, and the response is {entries, next_after, head} where next_after is the last served seq — clients and mirrors page gap-free until a short or empty batch.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L350-L361",
          "version": "repo-lines-v1:sha256:6249719ceb2f81c3bea6973a50898729d5644bcf159ee6f084f2df4183d0385e:"
