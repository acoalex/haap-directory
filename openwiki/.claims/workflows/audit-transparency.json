    },
    {
      "id": "claim_a9d70620bd0e43d6b664e3ac91d18ad4",
      "statement": "GET /v1/audit/verify?seq=<n> is a directory-side recompute convenience: AuditService.verify pages the full chain from genesis (1000 entries per page) until it reaches seq, runs audit.verify_chain over the prefix, and returns {valid, computed_head}; the SPEC directs that clients SHOULD verify locally from raw entries instead of trusting this convenience endpoint.",
      "evidence": [
        {
          "resource": "repo://docs/SPEC.md#L757-L758",
          "version": "repo-lines-v1:sha256:a179c67b98969b81ca9389abbe7061b64196d81decf421c0cea614bbbda7d7c0:"
