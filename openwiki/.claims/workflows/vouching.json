        }
      ]
    },
    {
      "id": "claim_8a0611eb8ace47d3ba9fb114747233f7",
      "statement": "The annotations block is computed from edges and exposed raw: mutual_vouch_density is the share of the agent's active inbound vouchers whom the agent also vouches back to via a non-revoked outgoing edge (outgoing expiry is not checked, so an expired-but-unrevoked outgoing edge still counts), rounded to 4 decimals, 0.0 with no inbound vouchers; vouchers_share_registration_cluster is hard-coded False because registration-IP clustering is not tracked in this build — an honest no-signal default, not a measured fact.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/vouching.py#L126-L143",
          "version": "repo-lines-v1:sha256:4942a0535a2ee8bc871d5a0d885ec8a79abaf3767730abbc0a7bc7daf2f954d4:"
        }
      ]
    },
    {
      "id": "claim_1c1191744212471cad8afe7300279fcb",
      "statement": "GET /v1/agents/{fingerprint}/vouches/outgoing returns the voucher's full issuance history — active, revoked, and expired edges together — ordered by created_epoch DESC, each with voucher_fingerprint, vouchee_fingerprint, scope, created_at, expires_at, and revoked_at (non-null exactly for revoked edges); it carries no annotations block and no tenure label.",
      "evidence": [
