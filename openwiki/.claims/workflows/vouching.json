        }
      ]
    },
    {
      "id": "claim_b099601981394d018429f53f0aa3df30",
      "statement": "GET /v1/agents/{fingerprint}/vouches returns active-only inbound edges (revoked_at IS NULL AND expires_epoch >= now) ordered by created_epoch DESC, each edge carrying voucher_fingerprint, scope, created_at, expires_at, revoked_at, and voucher_tenure_hours — plus the annotations object; the note field is never returned.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/store.py#L745-L759",
          "version": "repo-lines-v1:sha256:b8cdd763c88f690d9f74ec660038fde7b1601ba0c18f8cab57957948aab5e1ac:"
