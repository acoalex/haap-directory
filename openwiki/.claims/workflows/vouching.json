    {
      "id": "claim_eccffb424da9408fbc1297a86dfd374a",
      "statement": "The inbound and outgoing graph GET routes apply no liveness gate and no per-IP rate limit to the queried fingerprint, so vouches of suspended or expired agents remain readable (frozen visible next to the record), while the v1 profile endpoint refuses non-live agents with AGENT_NOT_LISTED — an unknown fingerprint simply returns empty edges and zero-valued annotations.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L273-L284",
          "version": "repo-lines-v1:sha256:6508ea439e648bde214feb68f0dac186a45dafb458488d1841da9365b2723e0e:"
