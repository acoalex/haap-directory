  "claims": [
    {
      "id": "claim_fe621b5302f0442ea8229f69c7066690",
      "statement": "Vouches are opinions with signatures, not facts: the directory enforces mechanics only (live keys, caps, expiry, revocation validity), serves the vouch graph as raw edges with no aggregate score, and makes collusion rings visible rather than stopping them; consumers apply their own trust set.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/vouching.py#L1-L8",
          "version": "repo-lines-v1:sha256:240a5986a5ef553fcb1d0b025f4e8b9b019f08fc2cec017eafe9dc5faa5f3e4e:"
        }
      ]
    },
    {
      "id": "claim_2f514518626049909b425005706adad7",
      "statement": "VouchService.create validates body fields in order: scope must be a non-empty lowercase string (the canonical scope prefixes identity, task_delivery, service:, payment are declared but never enforced as membership), weight must equal 1 in v1, created_at and expires_at must be RFC 3339 strings, expires_at must be in the future (VOUCH_EXPIRED), and expires_at minus created_at must not exceed config.vouch_max_expiry_days (default 180 days, else VOUCH_INVALID).",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/vouching.py#L22-L22",
          "version": "repo-lines-v1:sha256:90a2bdc9a1afb20bca772350242fc6486aaf1cc52195e80caf679e28ed06d8e5:"
        },
        {
          "resource": "repo://src/haap_directory/vouching.py#L40-L63",
          "version": "repo-lines-v1:sha256:d2a957f4847455317da348fdf2a394f13c879cd0f0eb3982b1ba3fd287de6c57:"
        }
      ]
    },
    {
      "id": "claim_3c1aba4f97a24deaa889f499c279109d",
      "statement": "Granting a vouch requires both parties to be currently live listed agents (Store.is_live_row: status listed, not history, unexpired) — a missing or non-live voucher yields VOUCHER_NOT_LISTED (400) and vouchee VOUCHEE_NOT_LISTED (404) — and a signature over the whole body minus the signature field, verified via verify_over against the public key read from the voucher's live row, else SIGNATURE_MISMATCH (400).",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/signing.py#L18-L25",
          "version": "repo-lines-v1:sha256:7fe223ff4c8336ff6e323383e91837f954a5d95c141c57b90e4b3fef1a84f50d:"
        },
        {
