    {
      "id": "claim_2adfb6de450149d78daf0e90fee795c5",
      "statement": "GET /v1/trust/paths runs BFS over active edges only (Store.active_vouch_edges: revoked_at IS NULL AND expires_epoch >= now), clamps max_depth to 2 (max(1, min(int(max_depth), 2))), enumerates every simple source-to-target path of length at most max_depth with a per-path seen set so nodes are not revisited, and returns raw edge lists {voucher_fingerprint, vouchee_fingerprint, scope, created_at, expires_at, revoked_at} as {\"paths\": [...]} (empty when none) — the directory computes no aggregate, distance, or score over paths.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L363-L372",
          "version": "repo-lines-v1:sha256:c91c987a083b90703e41a806d7cbe3e07b984932712f6636fc663e4c6523ee91:"
        },
