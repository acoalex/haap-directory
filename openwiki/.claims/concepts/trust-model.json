        }
      ]
    },
    {
      "id": "claim_2fa71a11d81c46a6a8745258657399b1",
      "statement": "The directory's Ed25519 key signs the chain head hourly (checkpoint_interval_s, default 3600) via AuditService.maybe_checkpoint/create_checkpoint and once more on graceful shutdown; audit responses are signed with X-HAAP-Directory-Signature plus X-HAAP-Directory-Fingerprint headers, and audit.verify_chain recomputes every hash to check prev_hash linkage — so consumers holding an earlier signed checkpoint can detect any later rewrite of the log.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit.py#L67-L91",
          "version": "repo-lines-v1:sha256:44577e95fb492de2aac181a9990d273b73621cfd47ca1d91a4ba57504a6ae4c6:"
