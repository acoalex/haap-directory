          "version": "repo-lines-v1:sha256:0db636ea33892f72f4f3484a286a8fcbd1672ea3b74b85a792828b25fb1f8ae4:"
        }
      ]
    },
    {
      "id": "claim_6111502310a248c3b898ec2cca08b3d5",
      "statement": "L4 reports count toward automation only from eligible reporters — live listed agents with at least report_tenure_hours (72) of tenure, deduplicated per reporter+target+category within the report_dup_window_hours (24) window — while counters() returns raw store tallies within the report_decay_days (180) window, and _maybe_auto_suspend suspends only when at least auto_suspend_threshold (3) unique eligible reporters accuse the target in one of the ABUSE_CLASSES within the rolling report_window_days (7) window; suspension is an audited, appealable abuse filter and non-abuse categories never auto-suspend.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/config.py#L57-L62",
          "version": "repo-lines-v1:sha256:21ad2b3504aa1838c09cc860e5c9f3f03d8a9b1f61c27051248e932da2420344:"
        },
