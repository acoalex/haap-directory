          "version": "repo-lines-v1:sha256:4b1ac0e621fe753e07f3802b065b308069380fb5745ff99419e4e20498a2bd73:"
        },
        {
          "resource": "repo://src/haap_directory/service.py#L422-L434",
          "version": "repo-lines-v1:sha256:7aa88d0a740b6ef1658a7dedcb6999ab07c0ae93b8bcc4646b88aa65f133755d:"
