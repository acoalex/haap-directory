    {
      "id": "claim_efacadd89d6047719ba3ac82fa5f7afe",
      "statement": "The directory never confirms a suspended or expired listing to anonymous callers: profile lookup answers 404 AGENT_NOT_LISTED for any non-live row without distinguishing suspension from expiry, and a heartbeat that fails signature verification is answered UNKNOWN_OR_EXPIRED rather than with an existence-confirming error; suspension is thereby hidden, not broadcast as a verdict.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/service.py#L188-L217",
          "version": "repo-lines-v1:sha256:00321bdb974b2abec4df59cc85d376380b7c87cdbe0506d9e4fc1c2a56bf11be:"
        },
        {
          "resource": "repo://src/haap_directory/service.py#L248-L255",
          "version": "repo-lines-v1:sha256:a01d5aadfe5a7461464e818ddfebf86e70dda408a61d1f632968811f5e498772:"
        }
      ]
    },
    {
      "id": "claim_05ca6d0bb5b4499cbe1b5d04f019aa6e",
      "statement": "L0 registration binding: submit_registration verifies the manifest Ed25519 signature over the canonical JSON of the manifest against the presented public key and recomputes the fingerprint as HF- plus the first 16 hex chars of sha256 of the raw public key, rejecting mismatches with FINGERPRINT_MISMATCH, so a listing is bound to the key that can sign for it; bulk key minting stays ~free by design because L0's purpose is attribution for the higher layers.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/identity.py#L19-L22",
          "version": "repo-lines-v1:sha256:122efe51d8d9c00677d9200b97723e5be2acb7dd4267dbcda85f6d283c36d850:"
        },
        {
          "resource": "repo://src/haap_directory/service.py#L84-L102",
          "version": "repo-lines-v1:sha256:9d42e5d37364991ce2f413e0466f49161225d3487b4f33c64c5c97bd6964fdaf:"
        }
      ]
    },
    {
      "id": "claim_0fec6d78967e4231bff4e3c4298e45ab",
      "statement": "L1 proof-of-endpoint is a two-step single-use challenge: submit_registration stores a challenge with a 120-second TTL bound to the exact public key and its manifest, and complete_registration lists the agent only if endpoint_proof verifies against the challenge-bound key over the nonce bytes, with single-use (CHALLENGE_USED), expiry (CHALLENGE_EXPIRED) and key-binding (KEY_MISMATCH) enforced; the directory never contacts the declared endpoint itself.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/config.py#L32-L32",
          "version": "repo-lines-v1:sha256:df9c406e83f9023b8e52b82cace0fa8dcc30873ab532bf98ff7430e5c311beb3:"
        },
