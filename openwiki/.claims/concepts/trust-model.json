    {
      "id": "claim_7fbfe84383674f308f8bc4e974a64c97",
      "statement": "The vouch graph is served as raw edges only: inbound_signal exposes each active edge with voucher_tenure_hours, annotations reports the computed mutual_vouch_density while exposing vouchers_share_registration_cluster as False because registration-IP clustering is not tracked in this build (absence reported honestly rather than fabricated), and trust_paths is a depth-capped (2) BFS returning raw edge lists — the directory computes no path score, PageRank or other aggregate over the graph.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/vouching.py#L111-L143",
          "version": "repo-lines-v1:sha256:adc4f9f3a44f2c5faa71c18ef38f927f525cf504cebba86e0fb0a5c3f4d935ff:"
        },
