    {
      "id": "claim_e909b8230e7f487eb654d89b8f9c1a5a",
      "statement": "L5 chain atomicity: every state change and its single audit entry commit in the same BEGIN IMMEDIATE transaction — store mutators call _append_audit inside the _write transaction, which links entry n to entry n-1 via prev_hash and stores entry_hash = sha256(canonical_json(entry)); only sha256 detail hashes (never detail bodies) enter the chain, and an empty log starts from a genesis entry whose prev_hash is 64 zeros.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit.py#L39-L64",
          "version": "repo-lines-v1:sha256:38b0f6ebfbb08371af1778c1e45f8062963b3e3a62abf07472cacf65465db19b:"
