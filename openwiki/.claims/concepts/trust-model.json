    {
      "id": "claim_5bdaa713f44c4aec9c8cbac039398831",
      "statement": "L3 vouching enforces mechanics only: VouchService.create requires both parties to be live listed agents (VOUCHER_NOT_LISTED/VOUCHEE_NOT_LISTED), the voucher's signature over the body minus the signature field, weight 1, and a mandatory future expires_at within vouch_max_expiry_days (180), while the store enforces the cap of vouch_max_outgoing (10) active outgoing vouches; vouching never verifies offline identity or predicts behaviour.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/config.py#L52-L54",
          "version": "repo-lines-v1:sha256:59050ec1ae122695f33423433f6bf853f5ca4d0ad462711f9e303a4bea9e2a61:"
        },
        {
