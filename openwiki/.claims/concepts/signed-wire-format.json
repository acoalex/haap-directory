          "version": "repo-lines-v1:sha256:7aacbf58763d6e6665ed90e93c1462ff8e77cb7cae606d8a9a160948446c31de:"
        }
      ]
    },
    {
      "id": "claim_6fc94d0c4cdd44d287ca8dc8d21330bd",
      "statement": "The directory key signs its own outputs with the same canonical form and conventions: legacy register responses add registry_signature (b64 Ed25519 over the ASCII challenge nonce) plus registry_fingerprint/directory_fingerprint, and audit responses and checkpoints are signed by the directory key over canonical_json of the response body, carried in the X-HAAP-Directory-Signature and X-HAAP-Directory-Fingerprint headers so consumers can detect rewrites of anything already seen.",
      "evidence": [
