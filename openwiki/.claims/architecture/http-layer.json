        }
      ]
    },
    {
      "id": "claim_68fc44aa3d4644a6bda68230a0d9e1bb",
      "statement": "Every response carries X-Request-Id: the server echoes an inbound X-Request-Id header when present, otherwise it generates one of the form req_<hex>; the same id appears in error envelopes.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L146-L158",
          "version": "repo-lines-v1:sha256:9bb1d222ab7a6006dfc7075a7025b6c2df6501147985f0ce99b4369b2ca987f4:"
        }
