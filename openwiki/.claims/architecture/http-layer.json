        }
      ]
    },
    {
      "id": "claim_ee0b7068f73b46e4bfcbfb56235d858f",
      "statement": "DirectoryHTTPServer keeps two lightweight GIL-protected counters that feed /metrics: ops_total is incremented on every request entering any verb handler (including /health and /metrics), and rejections[code] is incremented each time an error envelope is serialized, so every emitted rejection code is counted.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L168-L173",
          "version": "repo-lines-v1:sha256:12214d4cd20734a1259f2b7c99ea97111a60be31dd3504aa66e24f9bc8eca6b7:"
