    {
      "id": "claim_d481dfea89394e2aacedf55f2f50bfeb",
      "statement": "errors.py is normative for rejections: ERROR_STATUS is the master §4.10 table mapping every stable UPPER_SNAKE code to a fixed HTTP status, codes are add-only (never renamed or removed), and DirectoryError carries the code, its status, an optional retry_after, and a short default message from _DEFAULT_MESSAGES that must not leak internals; to_wire produces the single envelope {\"error\": {code, message, request_id}} used for every rejection.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/errors.py#L17-L70",
          "version": "repo-lines-v1:sha256:6d0558f4dc1439bab445ed801119a4bcca9efc45975f3c74c1436e79587bceb8:"
