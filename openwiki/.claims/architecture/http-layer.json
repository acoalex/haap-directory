    {
      "id": "claim_9c4da509647a43deae6882a7277c2cff",
      "statement": "JSON request bodies are parsed by _read_json: a missing or non-numeric Content-Length counts as an empty body treated as {}; a body over config.max_body_bytes (default 512 KiB) is rejected with PAYLOAD_TOO_LARGE (413) before reading the stream; malformed JSON is INVALID_JSON (400) and valid non-object JSON is INVALID_SCHEMA (400). The signed manifest has a stricter separate cap: submit_registration rejects canonical JSON over max_manifest_bytes (default 256 KiB) with MANIFEST_TOO_LARGE (413).",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/config.py#L35-L36",
          "version": "repo-lines-v1:sha256:37559bf3f5a4136af158d984b1df91ab84b7550ce92517f6ce2439b7e4c27557:"
        },
        {
