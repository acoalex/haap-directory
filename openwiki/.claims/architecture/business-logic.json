    {
      "id": "claim_92f68053bbdb4ef7863922d2d5a6e1ab",
      "statement": "Heartbeat renewal: heartbeat_v1 requires an RFC 3339 timestamp within MAX_CLOCK_SKEW_S = 300 seconds of the injected clock (STALE_TIMESTAMP) and a valid Ed25519 signature by the stored key over the ASCII message heartbeat:{fingerprint}:{timestamp}; unknown rows and failed signatures both raise UNKNOWN_OR_EXPIRED so the endpoint never confirms fingerprint existence to a caller that cannot sign, and success renews the TTL via store.heartbeat with audit event heartbeat.ok. The unsigned legacy heartbeat renews through the same store path but is audit-flagged heartbeat.legacy_unsigned.",
      "evidence": [
