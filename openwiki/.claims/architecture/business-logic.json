          "version": "repo-lines-v1:sha256:a6147199ac4b99c28a7c521bf9bfa8978388ef827bd4362ffe0181635517e550:"
        }
      ]
    },
    {
      "id": "claim_72016ac16e8f432ba86e6a2192ebf097",
      "statement": "_matches_query semantics: capability is a case-insensitive substring over a haystack of agent.speciality, services[].id, services[].category, tools[] and skills[].name; q is an AND of every whitespace-separated word against the lowercased canonical JSON of the whole manifest; geo compares the haversine distance in km from the query point to the manifest geo (read as lat_microdeg/lon_microdeg or decimal lat/lon) against radius_km, and agents without geo are excluded whenever a geo filter is present.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/service.py#L374-L419",
          "version": "repo-lines-v1:sha256:771c6c1267d2b8438a0a310304500fec89cb041a2401cfa12382eb3df4969c73:"
        }
      ]
    },
    {
      "id": "claim_52592381af914e248c165f7181f2004b",
      "statement": "_passes_trust_filters applies consumer-chosen filters to the assembled trust block: not_suspended (default True) excludes suspended status; min_age_hours excludes entries younger than age_days * 24 hours; domain_verified=True excludes entries without a primary domain verification (one-sided, false does not require unverified); min_vouches_in counts visible active inbound vouch edges only; recent_reports_max excludes entries whose reports.unique_reporters exceeds the ceiling. Because store.live_agents returns only status='listed' rows, suspended agents are excluded from search by construction and the suspension filter is defense in depth.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/service.py#L422-L434",
          "version": "repo-lines-v1:sha256:7aa88d0a740b6ef1658a7dedcb6999ab07c0ae93b8bcc4646b88aa65f133755d:"
