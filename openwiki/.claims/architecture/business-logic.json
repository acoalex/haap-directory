    {
      "id": "claim_9ea0b4f4b36f4324acc2c9f73b22bcf5",
      "statement": "SearchQuery parses and clamps search parameters: capability and q are stripped and lowercased; geo is parsed as lat,lon,radius_km floats with unparseable input silently becoming no filter; limit is clamped to max(0, min(int(limit), 100)) with default 20 and never errors; offset is floored at 0; min_age_hours defaults to 0.0; domain_verified is an optional bool that is None unless the query says 1/true/yes; not_suspended defaults to True; min_vouches_in defaults to 0; recent_reports_max is None unless supplied.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L304-L326",
          "version": "repo-lines-v1:sha256:d0429f0c96d0edb09e7dfc45174c04b255d6c45a037c011a63bc2bba02a99935:"
        },
