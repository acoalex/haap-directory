    {
      "id": "claim_5cea4146aa3c4b8c9508e70429dcf070",
      "statement": "Layering rule: http_api.py handles transport concerns (routing, bodies, headers, rate limits) without touching state; DirectoryService and its sub-services perform validation and orchestration; every state change goes through Store, which persists it and appends exactly one L5 audit entry in the same BEGIN IMMEDIATE write transaction. New mutating logic must preserve this shape.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/service.py#L1-L12",
          "version": "repo-lines-v1:sha256:2d397f7cb240a160c9f0d54dceb2856bb8a7c8ee3a2bcfbcdcb038d43f091b3b:"
        },
