  "claims": [
    {
      "id": "claim_1a08af68fd4441ce87b06a9378d818d7",
      "statement": "The HAAP Public Directory is the federated phone book of the HAAP ecosystem, and its one non-negotiable design principle is that the directory is a phone book, not a notary — and never a judge: identity lives in the agents' Ed25519 keys, not in the directory; the directory verifies signature math and endpoint control so its compromise can never allow impersonation; and it returns labelled signals with provenance (domain_verified, vouches_in, reports, status, block_recommendation, audit_verifiable) and never a safe/trusted verdict or a collapsed trust score — the consumer always decides.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L15-L24",
          "version": "repo-lines-v1:sha256:788eb7194c8cfdf2f6198175e361002a6a65e4d4df746192c2da2ed44a86b301:"
        },
