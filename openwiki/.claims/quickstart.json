    {
      "id": "claim_578f7bf96b554b77bfdb928675917ef9",
      "statement": "haap-directory is the production, SQLite-backed evolution of the in-memory reference registry that ships inside the haap client package, stays wire-compatible with it, and has every phase of the SPEC §7 build plan (F0–F6) implemented, tested and green, so the full L0–L5 trust ladder is live.",
      "evidence": [
        {
          "resource": "repo://README.md#L16-L40",
          "version": "repo-lines-v1:sha256:c39a151f9672b3805b31b8472d879708cddabb0a6a6c118e8d0a726dc73905af:"
