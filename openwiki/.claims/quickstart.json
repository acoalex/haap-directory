    {
      "id": "claim_7c5252fa090c406bbca6ed734f7240ef",
      "statement": "The authoritative source order for this repo is: source code and tests first, then docs/SPEC.md as the normative self-contained contract (RFC 2119 MUST/SHOULD/MAY), with docs/OPERATE.md (operator runbook) and docs/MODERATION.md (append-only moderation runbook/policy log) as operational guidance that can lag code; AGENTS.md directs implementers to read SPEC first for architecture/API questions and the runbooks for ops and moderation questions.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L104-L108",
          "version": "repo-lines-v1:sha256:e30c80d75c0f6e9dcd30a889469cf2b9a1f28ef20d88b0909436bb41f1d86710:"
        }
