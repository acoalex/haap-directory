    },
    {
      "id": "claim_a55ae32330a64bd69bfa03ac3ceb5e30",
      "statement": "Canonical JSON is frozen to json.dumps with sort_keys=True, compact separators (',' and ':') and ensure_ascii=False encoded as UTF-8, and it is deliberately vendored byte-for-byte in src/haap_directory/canonical.py rather than imported from the haap client package, so the directory has no hard import dependency on the client; any deviation from this serialization breaks signature verification.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/canonical.py#L1-L26",
          "version": "repo-lines-v1:sha256:268dcf28e2e84fca2aee88333439fcfb5bc1950f93eeb1918a128e36a21f103b:"
        }
      ]
    },
    {
      "id": "claim_2a705fd3d7064e38ba7d32693cc3f4d6",
      "statement": "Error codes are API: errors.py:ERROR_STATUS is the SPEC §4.10 master table and is add-only (never rename, remove or repurpose a code); every rejection surfaces the stable envelope {error: {code, message, request_id}} built by DirectoryError, whose messages are short and must not leak internals, and 429 responses carry Retry-After from the error's retry_after value.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/errors.py#L1-L11",
          "version": "repo-lines-v1:sha256:acff29f95fb7df1b59f77b18046a0cb272e6f7cc2af17ad92f3f75735186503f:"
        },
        {
