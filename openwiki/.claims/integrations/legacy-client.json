    {
      "id": "claim_fa8d6a4118b94fcfaab869935e5dd717",
      "statement": "Legacy POST /register/complete works without a challenge_id: complete_registration falls back to store.latest_pending_challenge(fingerprint), the most recent unused pending endpoint challenge, while keeping the v1 single-use, expiry, fingerprint-match and bound-key checks and the endpoint proof over the challenge nonce identical; the legacy alias answers 200 (v1: 201) with {status: 'registered', agent_url, expires_at, directory_fingerprint, ttl_seconds}, the status field the unmodified client's register() asserts.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L508-L518",
