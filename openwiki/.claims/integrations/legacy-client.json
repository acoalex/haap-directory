    {
      "id": "claim_80888324ab3b4d818eed175f32f3eaa6",
      "statement": "POST /register (legacy) takes the same {manifest, public_key_b64, manifest_signature} body as POST /v1/register and answers 200 (v1: 202) with the legacy challenge envelope {challenge_nonce, nonce, challenge_id, registry_fingerprint, directory_fingerprint, registry_signature, expires_at}, where registry_signature is the base64 Ed25519 signature of the directory key over the ASCII challenge nonce and challenge_nonce — the only field the unmodified client reads — is the same nonce whose bytes the agent signs for the endpoint proof; the v1 shape adds algorithm and ttl_seconds instead.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L483-L506",
          "version": "repo-lines-v1:sha256:16906330f3aedbd6a45d108c50b7e79ff103e6ec3be2255bb2d6f1f9cb606e1c:"
        },
