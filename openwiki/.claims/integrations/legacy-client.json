    {
      "id": "claim_e47a0748c64e408d9a795844e2239ae9",
      "statement": "GET /search (legacy) answers {results: [bare manifests]} built from DirectoryService.search's bare-manifest projection of the identical matching, trust filtering and pagination that v1 serializes with per-result trust blocks plus total, limit, offset and directory_fingerprint, so legacy consumers read manifest fields such as agent.fingerprint and agent.endpoint directly off each result; /search and /v1/search also share the same per-IP search token bucket and the same SearchQuery parameters.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L249-L254",
