    {
      "id": "claim_bd463287ad9e42edb2a812f1b7b6325b",
      "statement": "The unsigned legacy heartbeat is honored only on the alias route: _handle_heartbeat forces the signed heartbeat_v1 verification whenever the path is /v1/heartbeat or the body carries signature and timestamp, so only an unsigned {fingerprint} body on POST /heartbeat reaches heartbeat_legacy, which renews through the same store.heartbeat write path flagged legacy=True and therefore appends the audit event heartbeat.legacy_unsigned instead of heartbeat.ok; success answers 200 {status: 'ok'} (the client's heartbeat() returns True) and an unknown or expired fingerprint answers 404 UNKNOWN_OR_EXPIRED.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L520-L537",
          "version": "repo-lines-v1:sha256:804c84d8b6e0485c283df43ca4030dc39cdfc9b52b4e9807f57817df7afdd21c:"
