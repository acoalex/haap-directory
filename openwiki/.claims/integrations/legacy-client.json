  "claims": [
    {
      "id": "claim_2d4ac55bc6ba4c85bcc9437cc2111b2f",
      "statement": "Keeping the unmodified haap client package working is a spec-mandated hard constraint, not a courtesy feature: objective O8 and SPEC §4.9 treat the legacy aliases as a hard requirement, §6.3 fixes the contract as 'the haap client + its full unmodified test suite MUST keep working against this directory unmodified', and the authoritative route table is the haap repo's tests/test_registry_client.py, which must stay green unchanged in every phase from F1 on — so a change that alters legacy route semantics or canonical serialization is breaking and must not ship.",
      "evidence": [
        {
          "resource": "repo://docs/SPEC.md#L1068-L1080",
          "version": "repo-lines-v1:sha256:593b797b60b3883d877711df6088b7c9b2c90a66d29962bf149e50bd200edd44:"
        },
        {
          "resource": "repo://docs/SPEC.md#L75-L75",
