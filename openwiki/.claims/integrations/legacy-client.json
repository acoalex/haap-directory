    {
      "id": "claim_45f6f7eae0f94d40a91e223140e60b0c",
      "statement": "Canonical JSON is vendored in src/haap_directory/canonical.py byte-for-byte identical to the haap client's form — json.dumps(obj, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False).encode('utf-8') — because the directory verifies client-signed manifests over canonical bytes it recomputes itself, so any deviation breaks Ed25519 signature verification; vendoring rather than importing from haap removes any hard import dependency on the client package, and the runtime dependency list is only cryptography.",
      "evidence": [
        {
          "resource": "repo://docs/SPEC.md#L1080-L1080",
