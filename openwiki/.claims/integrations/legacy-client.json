          "version": "repo-lines-v1:sha256:2fdfb268e7ef702154c3c56e2ba51831866e4b26ba48fa94b9b94d351b21d3dd:"
        }
      ]
    },
    {
      "id": "claim_3b29b7a404a34beeb4d9b7a972d94a1f",
      "statement": "The legacy surface is exactly five aliases — POST /register, POST /register/complete, POST /heartbeat, GET /search, GET /agents/{fp} — plus the shared unversioned GET /health; each alias dispatches to the same handler method as its /v1 twin with a versioned boolean that changes only HTTP status and response serialization, never validation or service semantics, and one fingerprint regex accepts both the prefixed and bare /agents/{fp} paths.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/http_api.py#L2-L16",
          "version": "repo-lines-v1:sha256:c07e788bab6f21703385dc33130885727388720ea005b0b12a10abf1dc6f05ab:"
