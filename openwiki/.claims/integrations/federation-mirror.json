    {
      "id": "claim_cb2302e9c2cf46499d6019ffdab85e68",
      "statement": "The wire contract any external mirror implements is /v1/audit/log?after=<seq>&limit=<n> returning entries with seq strictly greater than after in contiguous ascending order (after defaults to -1; limit is clamped server-side to 1..1000 via max(1, min(limit, 1000))) with the envelope {entries, next_after, head} where next_after is the last returned seq and head is the current {seq, ts, entry_hash}; a page shorter than the requested limit or empty means the log is exhausted, which is the stop rule ingest_chain relies on.",
      "evidence": [
        {
          "resource": "repo://docs/SPEC.md#L755-L758",
          "version": "repo-lines-v1:sha256:a94cbf43cebc5c905a52c6cfa5dff5e402348fbf67c33101519ec67a62523313:"
