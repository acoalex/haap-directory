  "claims": [
    {
      "id": "claim_c03ef34d7ce044c0806aaa292ba0d2a3",
      "statement": "mirror.ingest_chain(base_url, page=500) downloads a directory's full audit chain by repeatedly GETting /v1/audit/log?after=<last seq>&limit=page starting at after=-1 (so the first page begins at genesis seq 0) and stopping when a batch is empty or shorter than the requested page size; it then verifies the concatenated entries locally with audit.verify_chain, fetches /v1/audit/head, and returns exactly {seq, entry_hash, entries, verified, matches_served_head}, where seq/entry_hash describe the local head (seq -1 and entry_hash None for an empty log) and matches_served_head is True only when verification passed and the local head hash equals the served head's entry_hash.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/mirror.py#L25-L54",
          "version": "repo-lines-v1:sha256:09afd30135c61acbb8f6357a9b933c5b0ae81f6e715c32a8cc42fe2078842945:"
        }
      ]
    },
    {
      "id": "claim_04b973826f65498cb905cb65b448061d",
      "statement": "The mirror's verification is pure chain-linkage recomputation, not directory-signature verification: audit.verify_chain rebuilds each entry from its eight canonical fields (seq, ts, event, fingerprint, actor, result, detail_hash, prev_hash), re-hashes it as sha256 over canonical JSON, compares against the stored entry_hash, and checks each row's prev_hash equals the previous row's entry_hash; mirror._get reads only the JSON body and discards response headers, so ingest_chain never cryptographically checks the X-HAAP-Directory-Signature that audit responses carry, and signature-level assurance requires the directory public key obtained out-of-band.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit.py#L67-L91",
          "version": "repo-lines-v1:sha256:44577e95fb492de2aac181a9990d273b73621cfd47ca1d91a4ba57504a6ae4c6:"
        },
        {
          "resource": "repo://src/haap_directory/http_api.py#L160-L166",
          "version": "repo-lines-v1:sha256:4dff09bfece92455275220b7621ff9dc43187428cff432fb84fca47c8936f57c:"
        },
        {
          "resource": "repo://src/haap_directory/mirror.py#L20-L22",
          "version": "repo-lines-v1:sha256:203d383f05a06c976d06e38d5590ce9e2ca5f5aa637c9e07e0ce83f7dff4a8fc:"
        }
