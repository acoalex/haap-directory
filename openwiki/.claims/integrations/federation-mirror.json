    {
      "id": "claim_ac4c59008bd0405c86c4b7fb3b6ae244",
      "statement": "GET /v1/audit/head returns {seq, entry_hash, ts} plus checkpoint_signature — a base64 Ed25519 signature of the directory key over the canonical JSON of {seq, entry_hash, ts} (AuditService.head/create_checkpoint) — and such signed checkpoints are written by a background thread on a cadence of checkpoint_interval_s (default 3600 s) plus a final checkpoint on server shutdown, so a consumer or mirror that polls at least that often bounds the undetected-rewrite window to the polling interval.",
      "evidence": [
        {
          "resource": "repo://src/haap_directory/audit_service.py#L40-L58",
          "version": "repo-lines-v1:sha256:ce15bd77dd1e329ce71a71c8f5b12ddb246afa3e8069d1c5dfdb071185724d40:"
